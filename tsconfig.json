{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@modules/*": ["./src/modules/*"],
      // Microservice migration: change to "@user/*": ["./src/*"]
      "@user/*": ["./src/modules/user/*"],
      // Microservice migration: change to "@notification/*": ["./src/*"]
      "@notification/*": ["./src/modules/notification/*"],
      // Microservice migration: change to "@contracts/*": ["./node_modules/@company/contracts/*"]
      "@contracts/*": ["./src/shared/contracts/*"]
    }
  }
}
