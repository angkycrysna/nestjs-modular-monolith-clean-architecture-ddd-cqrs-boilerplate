# ── App ──
NODE_ENV=development
PORT=3000
REQUEST_TIMEOUT_MS=30000

# ── Security ──
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
CORS_ORIGINS=http://localhost:3000
MAX_BODY_SIZE=100kb
HMAC_ENABLED=false
HMAC_SECRET=
CSRF_ENABLED=false

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=false

# ── Database Read Replica (optional — uncomment to enable read/write splitting) ──
# DB_REPLICA_HOST=
# DB_REPLICA_PORT=5432

# ── Redis (optional — cache operations are no-ops when not configured) ──
# REDIS_URL=redis://localhost:6379

# ── Kafka (optional — uncomment when using KafkaMessageBroker) ──
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=my-app
# KAFKA_GROUP_ID=my-app-group
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ── RabbitMQ (optional — uncomment when using RabbitMqMessageBroker) ──
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_EXCHANGE=app.events

# ── Auth (configure when setting up auth) ──
# JWT_SECRET=
# JWT_EXPIRATION=3600
